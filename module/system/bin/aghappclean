clear_app_caches() {
  packages | while IFS= read -r package; do
    [ -n "$package" ] || continue
    rm -rf \
      "/data/data/$package/cache" \
      "/data/user/0/$package/cache" \
      "/data/media/0/Android/data/$package/cache" 2>/dev/null
  done
}

force_system_policy() {
  save_private_dns_state || log "failed to save private DNS state"
  [ "$(settings get global private_dns_mode 2>/dev/null)" = "off" ] || \
    settings put global private_dns_mode off >/dev/null 2>&1
  specifier=$(settings get global private_dns_specifier 2>/dev/null)
  case "$specifier" in
    ''|null) ;;
    *) settings delete global private_dns_specifier >/dev/null 2>&1 ;;
  esac
  # The installer backed up IFW; keep it clear while filtering is active.
  # uninstall.sh restores the saved pre-module state.
  [ -d "$IFW_DIR" ] && rm -rf "$IFW_DIR"/* 2>/dev/null
}

cleanup_targets() {
  targets | while IFS= read -r target; do
    [ -e "$target" ] && rm -rf "$target" 2>/dev/null
  done
}

trap 'clear_app_caches' USR1

# A new boot or DNS takeover gets one immediate application-cache pass.
clear_app_caches
force_system_policy

while :; do
  sleep 60
  cleanup_targets
  clear_app_caches
  force_system_policy
done
